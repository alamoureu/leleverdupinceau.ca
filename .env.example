# Copy to .env.local and fill in for production.
# Do not commit .env or .env.local (they are in .gitignore).

# Firebase (optional – app has fallback config; use this to override per environment)
# Next.js uses NEXT_PUBLIC_ prefix for client-exposed env vars.
# NEXT_PUBLIC_FIREBASE_API_KEY=
# NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
# NEXT_PUBLIC_FIREBASE_PROJECT_ID=
# NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
# NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
# NEXT_PUBLIC_FIREBASE_APP_ID=
# NEXT_PUBLIC_FIREBASE_MEASUREMENT_ID=

# Legacy Vite vars (kept for compatibility; prefer NEXT_PUBLIC_ above)
# VITE_FIREBASE_API_KEY=
# VITE_FIREBASE_AUTH_DOMAIN=
# etc.

# Admin / protected routes (optional – change default passwords via env in auth service)
# See src/services/authService.js – in production, consider moving password hashes to env.

# Build
# NEXT_PUBLIC_SITE_URL=https://www.leleverdupinceau.ca

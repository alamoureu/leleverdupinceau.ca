# Copy to .env.local and fill in for production.
# Do not commit .env or .env.local (they are in .gitignore).

# Firebase (optional – app has fallback config; use this to override per environment)
# VITE_FIREBASE_API_KEY=
# VITE_FIREBASE_AUTH_DOMAIN=
# VITE_FIREBASE_PROJECT_ID=
# VITE_FIREBASE_STORAGE_BUCKET=
# VITE_FIREBASE_MESSAGING_SENDER_ID=
# VITE_FIREBASE_APP_ID=
# VITE_FIREBASE_MEASUREMENT_ID=

# Admin / protected routes (optional – change default passwords via env in auth service)
# See src/services/authService.js – in production, consider moving password hashes to env.

# ERP website lead webhook (optional)
# Relative path is recommended: Vite + Netlify proxy it to the server (avoids CORS in the browser).
# VITE_ERP_WEBSITE_LEAD_URL=/api/webhooks/leads/website
# Or full URL (requires CORS on the ERP for your site origin): https://llp-erp-server.onrender.com/api/webhooks/leads/website
# Force direct URL even when path matches the proxy (e.g. non-Netlify host without a proxy rule):
# VITE_ERP_WEBSITE_LEAD_DIRECT=true

# Build
# VITE_SITE_URL=https://www.leleverdupinceau.ca

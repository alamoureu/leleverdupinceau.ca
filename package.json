{
  "name": "leleverdupinceau",
  "version": "0.1.0",
  "private": true,
  "dependencies": {
    "@chakra-ui/react": "^2.0.0",
    "@emotion/react": "^11.13.5",
    "@emotion/styled": "^11.13.5",
    "firebase": "^11.0.2",
    "framer-motion": "^11.13.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-helmet": "^6.1.0",
    "react-icons": "^5.4.0",
    "react-router-dom": "^7.0.2"
  },
  "scripts": {
    "start": "vite",
    "build": "PLAYWRIGHT_BROWSERS_PATH=0 vite build && node scripts/check-route-cannibalization.mjs && node scripts/check-before-after-dupes.mjs && PLAYWRIGHT_BROWSERS_PATH=0 node scripts/prerender.mjs && node scripts/validate-hero-contrast.mjs",
    "build:spa": "vite build",
    "prerender": "PLAYWRIGHT_BROWSERS_PATH=0 node scripts/prerender.mjs",
    "prerender:audit": "node scripts/all-public-routes.mjs",
    "check:routes": "node scripts/check-route-cannibalization.mjs",
    "check:before-after": "node scripts/check-before-after-dupes.mjs",
    "sitemap:generate": "node scripts/generate-sitemap.mjs",
    "validate:crawler": "node scripts/validate-crawler-seo-all.mjs",
    "validate:hero-contrast": "node scripts/validate-hero-contrast.mjs",
    "playwright:install": "PLAYWRIGHT_BROWSERS_PATH=0 playwright install chromium",
    "preview": "vite preview",
    "lint": "eslint src --ext .js,.jsx --max-warnings 0",
    "test": "node src/test/verify-routes.js",
    "open:routes": "node src/test/open-all-routes.js",
    "open:all": "node src/test/open-all-routes.js --all",
    "open:subservices": "node scripts/open-subservice-cards.js",
    "open:modified": "node scripts/open-modified-pages.js",
    "open:modified:tabs": "node scripts/open-modified-pages.js --tabs",
    "open:modified:chrome": "node scripts/open-modified-pages.js --chrome",
    "review:pages": "node scripts/open-modified-pages-for-review.js",
    "review:pages:list": "node scripts/open-modified-pages-for-review.js --list",
    "images:compress": "node scripts/compress-images.js",
    "images:optimize-ba": "node scripts/compress-images.js --max-dim=1080 --include=avant --include=before_after",
    "images:to-webp": "node scripts/convert-to-webp.js",
    "images:byte-dupes": "node scripts/find-image-byte-dupes.js"
  },
  "eslintConfig": {
    "root": true,
    "env": {
      "browser": true,
      "es2021": true,
      "node": true
    },
    "extends": [
      "eslint:recommended",
      "plugin:react/recommended",
      "plugin:react-hooks/recommended"
    ],
    "parserOptions": {
      "ecmaVersion": "latest",
      "sourceType": "module",
      "ecmaFeatures": {
        "jsx": true
      }
    },
    "settings": {
      "react": {
        "version": "detect"
      }
    },
    "rules": {
      "react/react-in-jsx-scope": "off",
      "react/prop-types": "off"
    }
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.3.4",
    "eslint": "^8.57.0",
    "eslint-plugin-react": "^7.34.0",
    "eslint-plugin-react-hooks": "^4.6.0",
    "playwright": "^1.49.1",
    "sharp": "^0.33.5",
    "vite": "^6.0.3"
  },
  "packageManager": "yarn@4.10.3+sha512.c38cafb5c7bb273f3926d04e55e1d8c9dfa7d9c3ea1f36a4868fa028b9e5f72298f0b7f401ad5eb921749eb012eb1c3bb74bf7503df3ee43fd600d14a018266f"
}
